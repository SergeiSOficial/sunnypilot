#define lint162aint16(v) v
#define lint162aint16vec4(v) v
#endif

#define unpackInt4x8(v) ivec4((v<<24)>>24,(v<<16)>>24,(v<<8)>>24,v>>24)
#define packInt4x8(v) int((uint(v.r)&0xFFu)|((uint(v.g)&0xFFu)<<8)|((uint(v.b)&0xFFu)<<16)|((uint(v.a)&0xFFu)<<24))
#define unpackInt2x16(v) ivec2((int(v)<<16)>>16,int(v)>>16)
#define packInt2x16(v) int((uint(v.r)&0xFFFFu)|((uint(v.g)&0xFFFFu)<<16))
#define float2int8(v) int(clamp(float(v)+(float(v)>=0.f?0.5f:-0.5f),-127.f,127.f))
#define float2int8vec4(v) ivec4(clamp(vec4(v)+mix(vec4(-0.5f),vec4(0.5f),greaterThanEqual(vec4(v),vec4(0.f))),vec4(-127.f),vec4(127.f)))

#if NCNN_int8_storage
#define i8buffer_ld1(buf,i) int(buf[i])
#define i8buffer_st1(buf,i,v) {buf[i]=int8_t(v);}
#define i8buffer_cp1(buf,i,sbuf,si) {buf[i]=sbuf[si];}
#else
#define i8buffer_ld1(buf,i) int(((buf[(i)/4])<<(24-((i)%4)*8))>>24)
#define i8buffer_st1(buf,i,v) {uint _i=uint(i);uint _id4=_i/4;uint _im4=_i%4;int _vs=int(v);int _old_v, _new_v;do{_old_v=atomicCompSwap(buf[_id4],0,0);ivec4 _v=unpackInt4x8(_old_v);_v[_im4]=_vs;_new_v=packInt4x8(_v);} while(atomicCompSwap(buf[_id4],_old_v,_new_v)!=_old_v);}
#define i8buffer_cp1(buf,i,sbuf,si) {int _v=i8buffer_ld1(sbuf,si);i8buffer_st1(buf,i,_v);}
#endif
#define i8buffer_ld4(buf,i) unpackInt4x8(buf[i])
#define i8buffer_sm4(buf,i) buf[i]
#define i8buffer_st4(buf,i,v) {buf[i]=packInt4x8(v);}
#define i8buffer_cp4(buf,i,sbuf,si) {buf[i]=sbuf[si];}
#define i8buffer_cp1to4(buf,i,sbuf,si) {ivec4 _v=ivec4(i8buffer_ld1(sbuf,si.r),i8buffer_ld1(sbuf,si.g),i8buffer_ld1(sbuf,si.b),i8buffer_ld1(sbuf,si.a));i8buffer_st4(buf,i,_v);}
#define i8buffer_cp4to1(buf,i4,sbuf,si) {ivec4 _v=i8buffer_ld4(sbuf,si);i8buffer_st1(buf,i4.r,_v.r);i8buffer_st1(buf,i4.g,_v.g);i8buffer_st1(buf,i4.b,_v.b);i8buffer_st1(buf,i4.a,_v.a);}

#if NCNN_int16_storage
#define i16buffer_ld1(buf,i) int(buf[i])
#define i16buffer_st1(buf,i,v) {buf[i]=int16_t(v);}
#elif NCNN_int16_packed
#define i16buffer_ld1(buf,i) unpackInt2x16(buf[(i)/2])[(i)%2]
#define i16buffer_st1(buf,i,v) {uint _i=uint(i);uint _id2=_i/2;uint _im2=_i%2;int _vs=int(v);int _old_v, _new_v;do{_old_v=atomicCompSwap(buf[_id2],0,0);ivec2 _v=unpackInt2x16(_old_v);_v[_im2]=_vs;_new_v=packInt2x16(_v);} while(atomicCompSwap(buf[_id2],_old_v,_new_v)!=_old_v);}
#else
#define i16buffer_ld1(buf,i) int(buf[i])
#define i16buffer_st1(buf,i,v) {buf[i]=int(v);}
#endif
#define i16buffer_ld2(buf,i) ivec2(i16buffer_ld1(buf,i),i16buffer_ld1(buf,(i)+1))

#if NCNN_int16_storage
#define i16buffer_st2(buf,i,v) {ivec2 _v=ivec2(v);buf[i]=int16_t(_v.r);buf[(i)+1]=int16_t(_v.g);}
#define i16buffer_sm4(buf,i) buf[i]
#if ncnn_shaderInt16
#define i16buffer_ld4(buf,i) buf[i]
#else
#define i16buffer_ld4(buf,i) ivec4(buf[i])
#endif
#define i16buffer_st4(buf,i,v) {buf[i]=i16vec4(v);}
#elif NCNN_int16_packed
#define i16buffer_st2(buf,i,v) {uint _i=uint(i);ivec2 _v=ivec2(v);if((_i&1u)==0u){buf[_i/2]=packInt2x16(_v);}else{i16buffer_st1(buf,int(_i),_v.r);i16buffer_st1(buf,int(_i)+1,_v.g);}}
#define i16buffer_sm4(buf,i) buf[i]
#if ncnn_shaderInt16
#if ncnn_vendorID == 0x5143
#define i16buffer_ld4(buf,i) i16vec4(unpackInt2x16(buf[i].r),unpackInt2x16(buf[i].g))
#else
#define i16buffer_ld4(buf,i) i16vec4(unpack16(buf[i].r),unpack16(buf[i].g))
#endif
#else
#define i16buffer_ld4(buf,i) ivec4(unpackInt2x16(buf[i].r),unpackInt2x16(buf[i].g))
#endif
#define i16buffer_st4(buf,i,v) {ivec4 _v=ivec4(v);buf[i]=ivec2(packInt2x16(ivec2(_v.r,_v.g)),packInt2x16(ivec2(_v.b,_v.a)));}
#else
#define i16buffer_st2(buf,i,v) {ivec2 _v=ivec2(v);buf[i]=int(_v.r);buf[(i)+1]=int(_v.g);}
#define i16buffer_sm4(buf,i) buf[i]
#define i16buffer_ld4(buf,i) ivec4(buf[i])
#define i16buffer_st4(buf,i,v) {buf[i]=ivec4(v);}
#endif

#define psc(x) (x==0?p.x:x)
#define ncnn_glsl_version 1

#if ncnn_enable_validation_layer
#define NCNN_LOGE debugPrintfEXT
#endif

layout(local_size_x=64, local_size_y=1, local_size_z=1) in;


#if 0 // Use the portable shared-memory tree; vendor subgroup results fail parity.
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#if NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#endif
#endif

layout(constant_id = 0) const int op = 0;

layout(binding = 0) writeonly buffer top_blob { sfp top_blob_data[]; };
layout(binding = 1) readonly buffer bottom_blob { sfp bottom_blob_data[]; };

layout(push_constant) uniform parameter
{
    int in_w;
    int in_h;
    int in_d;
    int in_c;
    int in_cstep;
    int in_dims;

    int out_w;
    int out_h;
    int out_d;
    int out_c;
    int out_dims;
    int out_cstep;

    int reduce_w;
    int reduce_h;
    int reduce_d;
    int reduce_c;

    int map_out_w;
    int map_out_h;
    int map_out_d;
    int map_out_c;

    float coeff;
} p;

shared afp sdata[256];

const float FLT_MAX_VALUE = 3.402823466e+38;
const float FLT_MIN_VALUE = 1.175494351e-38;

afp init_acc()
{
    if (op == 6) return afp(1.f);
    if (op == 4) return afp(-FLT_MAX_VALUE);
    if (op == 5) return afp(FLT_MAX_VALUE);
    return afp(0.f);
}

afp element_accum(afp acc, afp v)
{
    if (op == 0 || op == 3 || op == 9) return acc + v;
    if (op == 1 || op == 7) return acc + abs(v);
    if (op == 2 || op == 8) return acc + v * v;
    if (op == 4) return max(acc, v);
    if (op == 5) return min(acc, v);
    if (op == 6) return acc * v;
    if (op == 10) return acc + exp(v);
    return acc + v;
}

afp combine_accum(afp a, afp b)
{
    if (op == 4) return max(a, b);
    if (op == 5) return min(a, b);
    if (op == 6) return a * b;
    return a + b;
}

#if 0 // Use the portable shared-memory tree; vendor subgroup results fail parity.
afp subgroup_reduce_acc(afp v)
{
    if (op == 4) return subgroupMax(v);
    if (op == 5) return subgroupMin(v);
    if (op == 6) return subgroupMul(v);
    return subgroupAdd(v);
}
#endif

void decode_out(int out_index, out int ow, out int oh, out int od, out int oc)
{
    ow = 0;
    oh = 0;
    od = 0;
    oc = 0;

    if (p.out_dims == 1)
    {
        ow = out_index;
    }
    else if (p.out_dims == 2)
    {
        ow = out_index % p.out_w;
        oh = out_index / p.out_w;
    }
    else if (p.out_dims == 3)
    {
        ow = out_index % p.out_w;
        int t = out_index / p.out_w;
        oh = t % p.out_h;
        oc = t / p.out_h;
    }
    else
    {
        ow = out_index % p.out_w;
        int t0 = out_index / p.out_w;
        oh = t0 % p.out_h;
        int t1 = t0 / p.out_h;
        od = t1 % p.out_d;
        oc = t1 / p.out_d;
    }
}

int in_index(int iw, int ih, int id, int ic)
{
    if (p.in_dims == 1) return iw;
    if (p.in_dims == 2) return ih * p.in_w + iw;
    if (p.in_dims == 3) return ic * p.in_cstep + ih * p.in_w + iw;

    int in_dstep = p.in_w * p.in_h;
    return ic * p.in_cstep + id * in_dstep + ih * p.in_w + iw;
}

int out_offset(int ow, int oh, int od, int oc)
{
    if (p.out_dims == 1) return ow;
    if (p.out_dims == 2) return oh * p.out_w + ow;
    if (p.out_dims == 3) return oc * p.out_cstep + oh * p.out_w + ow;

    int out_dstep = p.out_w * p.out_h;
    return oc * p.out_cstep + od * out_dstep + oh * p.out_w + ow;
}

afp finalize_out(afp outv)
{
    if (op == 9 || op == 10) outv = log(outv);
    if (op == 8) outv = sqrt(outv < afp(FLT_MIN_VALUE) ? afp(0.f) : outv);
    if (p.coeff != 1.f) outv = outv * afp(p.coeff);
    return outv;
}

void main()
{
    const int out_index = int(gl_WorkGroupID.y);
    const int tid = int(gl_LocalInvocationID.x);

    int ow, oh, od, oc;
    decode_out(out_index, ow, oh, od, oc);

    int in_coord[4] = int[4](0, 0, 0, 0);
    if (p.map_out_w >= 0) in_coord[p.map_out_w] = ow;
    if (p.map_out_h >= 0) in_coord[p.map_out_h] = oh;
    if (p.map_out_d >= 0) in_coord[p.map_out_d] = od;
    if (p.map_out_c >= 0) in_coord[p.map_out_c] = oc;

    int in_w = p.in_w;
    int in_h = (p.in_h > 0) ? p.in_h : 1;
    int in_d = (p.in_d > 0) ? p.in_d : 1;
    int in_c = (p.in_c > 0) ? p.in_c : 1;

#if !NCNN_fp16_storage && !NCNN_fp16_packed && !NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
    // Pinned driver's FP32 [1,960,8,12] spatial mean. Match the host's eight
    // independent lanes, horizontal additions and division (not reciprocal multiply).
    // The uniform branch returns every lane before the generic reduction barriers.
    if (op == 3 && p.in_dims == 3 && in_w == 12 && in_h == 8 && in_c == 960 &&
        p.reduce_w == 1 && p.reduce_h == 1 && p.reduce_d == 0 && p.reduce_c == 0 &&
        p.coeff == 1.f / 96.f)
    {
        if (tid == 0)
        {
            precise float lanes[8];
            for (int lane = 0; lane < 8; lane++)
                lanes[lane] = buffer_ld1(bottom_blob_data, in_index(lane, 0, 0, in_coord[0]));
            for (int offset = 8; offset < 96; offset += 8)
                for (int lane = 0; lane < 8; lane++)
                {
                    int i = offset + lane;
                    lanes[lane] = lanes[lane] + buffer_ld1(bottom_blob_data, in_index(i % 12, i / 12, 0, in_coord[0]));
                }
            precise vec4 packed = vec4(lanes[0], lanes[1], lanes[2], lanes[3]) +
                                  vec4(lanes[4], lanes[5], lanes[6], lanes[7]);
            precise float left = packed.x + packed.y;
            precise float right = packed.z + packed.w;
            precise float summed = left + right;
            precise float quotient = summed / 96.f;
            precise float residual = fma(-quotient, 96.f, summed);
            precise float correction = residual / 96.f;
            precise float fold3_host_mean = quotient + correction;
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), fold3_host_mean);
        }
        return;
    }
#endif

    int reduce_size = 1;
    if (p.reduce_w != 0) reduce_size *= in_w;
    if (p.reduce_h != 0) reduce_size *= in_h;
    if (p.in_dims == 4 && p.reduce_d != 0) reduce_size *= in_d;
    if (p.in_dims >= 3 && p.reduce_c != 0) reduce_size *= in_c;

    afp acc = init_acc();

    for (int t = tid; t < reduce_size; t += 256)
    {
        int tt = t;

        int iw = in_coord[3];
        int ih = in_coord[2];
        int id = in_coord[1];
        int ic = in_coord[0];

        if (p.reduce_w != 0)
        {
            iw = tt % in_w;
            tt /= in_w;
        }
        if (p.reduce_h != 0)
        {
            ih = tt % in_h;
            tt /= in_h;
        }
        if (p.in_dims == 4 && p.reduce_d != 0)
        {
            id = tt % in_d;
            tt /= in_d;
        }
        if (p.in_dims >= 3 && p.reduce_c != 0) { ic = tt % in_c; }

        afp v = buffer_ld1(bottom_blob_data, in_index(iw, ih, id, ic));
        acc = element_accum(acc, v);
    }

#if 0 // Use the portable shared-memory tree; vendor subgroup results fail parity.
    afp sg = subgroup_reduce_acc(acc);

    if (subgroupElect())
    {
        sdata[int(gl_SubgroupID)] = sg;
    }

    barrier();

#if ncnn_subgroupSize >= 16
    // subgroupsize >= 16: num_sg = 256/subgroupsize <= 16 <= subgroupsize
    // One subgroup can cover all partial sums in a single subgroup reduce.
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int num_sg = int(gl_NumSubgroups);

        afp v = lane < num_sg ? sdata[lane] : init_acc();
        afp outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
        }
    }
#elif ncnn_subgroupSize == 8
    // num_sg = 32, subgroupsize = 8
    // Stage 2a: each of the first 4 subgroups reduces 8 consecutive partial sums
    if (int(gl_SubgroupID) < 4)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 8;

        afp v = sdata[base + lane];
        afp r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2b: subgroup 0 reduces the 4 remaining values
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);

        afp v = lane < 4 ? sdata[lane * 8] : init_acc();
        afp outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
        }
    }
#elif ncnn_subgroupSize == 4
    // num_sg = 64, subgroupsize = 4
    // Stage 2a: each of the first 16 subgroups reduces 4 consecutive partial sums
    if (int(gl_SubgroupID) < 16)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 4;

        afp v = sdata[base + lane];
        afp r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2b: first 4 subgroups each reduce 4 of the 16 remaining values
    if (int(gl_SubgroupID) < 4)
    {
        const int lane = int(gl_SubgroupInvocationID);
        const int base = int(gl_SubgroupID) * 16;

        afp v = sdata[base + lane * 4];
        afp r = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            sdata[base] = r;
        }
    }

    barrier();

    // Stage 2c: subgroup 0 reduces the final 4 values
    if (int(gl_SubgroupID) == 0)
    {
        const int lane = int(gl_SubgroupInvocationID);

        afp v = sdata[lane * 16];
        afp outv = subgroup_reduce_acc(v);

        if (subgroupElect())
        {
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
        }
    }
#else
    // General case: num_sg may exceed subgroup size.
    // Use shared memory tree reduction across all threads.
    // sdata[0 .. num_sg-1] holds the partial sums from stage 1.
    // We let threads tid < num_sg participate in the tree reduction.
    {
        const int num_sg = 256 / ncnn_subgroupSize;

        for (int stride = num_sg / 2; stride > 0; stride >>= 1)
        {
            if (tid < stride)
            {
                afp a = sdata[tid];
                afp b = sdata[tid + stride];
                sdata[tid] = combine_accum(a, b);
            }
            barrier();
        }

        if (tid == 0)
        {
            afp outv = sdata[0];
            outv = finalize_out(outv);
            buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
        }
    }
#endif

#else
    sdata[tid] = acc;
    barrier();

    for (int stride = 128; stride > 0; stride >>= 1)
    {
        if (tid < stride)
        {
            afp a = sdata[tid];
            afp b = sdata[tid + stride];
            sdata[tid] = combine_accum(a, b);
        }
        barrier();
    }

    if (tid == 0)
    {
        afp outv = sdata[0];
        outv = finalize_out(outv);
        buffer_st1(top_blob_data, out_offset(ow, oh, od, oc), outv);
    }
#endif
}
