#define packBFloat2x16(v) uint(((floatBitsToUint(v.x)+0x8000u)>>16)|((floatBitsToUint(v.y)+0x8000u)&0xffff0000u))
#elif NCNN_fp16_storage
#define sfp float16_t
#define sfpvec2 f16vec2
#define sfpvec4 f16vec4
#if NCNN_fp16_arithmetic
#define sfpmat4 f16mat4
#endif
