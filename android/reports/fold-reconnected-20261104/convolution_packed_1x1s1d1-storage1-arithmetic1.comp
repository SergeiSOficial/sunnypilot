#define lint162aint16vec4(v) v
#endif

#define unpackInt4x8(v) ivec4((v<<24)>>24,(v<<16)>>24,(v<<8)>>24,v>>24)
#define packInt4x8(v) int((uint(v.r)&0xFFu)|((uint(v.g)&0xFFu)<<8)|((uint(v.b)&0xFFu)<<16)|((uint(v.a)&0xFFu)<<24))
#define unpackInt2x16(v) ivec2((int(v)<<16)>>16,int(v)>>16)
#define packInt2x16(v) int((uint(v.r)&0xFFFFu)|((uint(v.g)&0xFFFFu)<<16))
#define float2int8(v) int(clamp(float(v)+(float(v)>=0.f?0.5f:-0.5f),-127.f,127.f))
#define float2int8vec4(v) ivec4(clamp(vec4(v)+mix(vec4(-0.5f),vec4(0.5f),greaterThanEqual(vec4(v),vec4(0.f))),vec4(-127.f),vec4(127.f)))

#if NCNN_int8_storage
#define i8buffer_ld1(buf,i) int(buf[i])
#define i8buffer_st1(buf,i,v) {buf[i]=int8_t(v);}
#define i8buffer_cp1(buf,i,sbuf,si) {buf[i]=sbuf[si];}
#else
#define i8buffer_ld1(buf,i) int(((buf[(i)/4])<<(24-((i)%4)*8))>>24)
#define i8buffer_st1(buf,i,v) {uint _i=uint(i);uint _id4=_i/4;uint _im4=_i%4;int _vs=int(v);int _old_v, _new_v;do{_old_v=atomicCompSwap(buf[_id4],0,0);ivec4 _v=unpackInt4x8(_old_v);_v[_im4]=_vs;_new_v=packInt4x8(_v);} while(atomicCompSwap(buf[_id4],_old_v,_new_v)!=_old_v);}
#define i8buffer_cp1(buf,i,sbuf,si) {int _v=i8buffer_ld1(sbuf,si);i8buffer_st1(buf,i,_v);}
#endif
#define i8buffer_ld4(buf,i) unpackInt4x8(buf[i])
#define i8buffer_sm4(buf,i) buf[i]
#define i8buffer_st4(buf,i,v) {buf[i]=packInt4x8(v);}
#define i8buffer_cp4(buf,i,sbuf,si) {buf[i]=sbuf[si];}
#define i8buffer_cp1to4(buf,i,sbuf,si) {ivec4 _v=ivec4(i8buffer_ld1(sbuf,si.r),i8buffer_ld1(sbuf,si.g),i8buffer_ld1(sbuf,si.b),i8buffer_ld1(sbuf,si.a));i8buffer_st4(buf,i,_v);}
#define i8buffer_cp4to1(buf,i4,sbuf,si) {ivec4 _v=i8buffer_ld4(sbuf,si);i8buffer_st1(buf,i4.r,_v.r);i8buffer_st1(buf,i4.g,_v.g);i8buffer_st1(buf,i4.b,_v.b);i8buffer_st1(buf,i4.a,_v.a);}

#if NCNN_int16_storage
#define i16buffer_ld1(buf,i) int(buf[i])
#define i16buffer_st1(buf,i,v) {buf[i]=int16_t(v);}
#elif NCNN_int16_packed
#define i16buffer_ld1(buf,i) unpackInt2x16(buf[(i)/2])[(i)%2]
#define i16buffer_st1(buf,i,v) {uint _i=uint(i);uint _id2=_i/2;uint _im2=_i%2;int _vs=int(v);int _old_v, _new_v;do{_old_v=atomicCompSwap(buf[_id2],0,0);ivec2 _v=unpackInt2x16(_old_v);_v[_im2]=_vs;_new_v=packInt2x16(_v);} while(atomicCompSwap(buf[_id2],_old_v,_new_v)!=_old_v);}
#else
#define i16buffer_ld1(buf,i) int(buf[i])
#define i16buffer_st1(buf,i,v) {buf[i]=int(v);}
#endif
#define i16buffer_ld2(buf,i) ivec2(i16buffer_ld1(buf,i),i16buffer_ld1(buf,(i)+1))

#if NCNN_int16_storage
#define i16buffer_st2(buf,i,v) {ivec2 _v=ivec2(v);buf[i]=int16_t(_v.r);buf[(i)+1]=int16_t(_v.g);}
#define i16buffer_sm4(buf,i) buf[i]
#if ncnn_shaderInt16
#define i16buffer_ld4(buf,i) buf[i]
#else
#define i16buffer_ld4(buf,i) ivec4(buf[i])
#endif
#define i16buffer_st4(buf,i,v) {buf[i]=i16vec4(v);}
#elif NCNN_int16_packed
#define i16buffer_st2(buf,i,v) {uint _i=uint(i);ivec2 _v=ivec2(v);if((_i&1u)==0u){buf[_i/2]=packInt2x16(_v);}else{i16buffer_st1(buf,int(_i),_v.r);i16buffer_st1(buf,int(_i)+1,_v.g);}}
#define i16buffer_sm4(buf,i) buf[i]
#if ncnn_shaderInt16
#if ncnn_vendorID == 0x5143
#define i16buffer_ld4(buf,i) i16vec4(unpackInt2x16(buf[i].r),unpackInt2x16(buf[i].g))
#else
#define i16buffer_ld4(buf,i) i16vec4(unpack16(buf[i].r),unpack16(buf[i].g))
#endif
#else
#define i16buffer_ld4(buf,i) ivec4(unpackInt2x16(buf[i].r),unpackInt2x16(buf[i].g))
#endif
#define i16buffer_st4(buf,i,v) {ivec4 _v=ivec4(v);buf[i]=ivec2(packInt2x16(ivec2(_v.r,_v.g)),packInt2x16(ivec2(_v.b,_v.a)));}
#else
#define i16buffer_st2(buf,i,v) {ivec2 _v=ivec2(v);buf[i]=int(_v.r);buf[(i)+1]=int(_v.g);}
#define i16buffer_sm4(buf,i) buf[i]
#define i16buffer_ld4(buf,i) ivec4(buf[i])
#define i16buffer_st4(buf,i,v) {buf[i]=ivec4(v);}
#endif

#define psc(x) (x==0?p.x:x)
#define ncnn_glsl_version 1

#if ncnn_enable_validation_layer
#define NCNN_LOGE debugPrintfEXT
#endif

layout(local_size_x=64, local_size_y=1, local_size_z=1) in;


#extension GL_GOOGLE_include_directive : enable
#include "vulkan_activation.comp"

#define LOCAL_MEMORY_UNROLL_INCH 8

layout(constant_id = 0) const int bias_term = 0;
layout(constant_id = 1) const int activation_type = 0;
layout(constant_id = 2) const float activation_param_0 = 0;
layout(constant_id = 3) const float activation_param_1 = 0;
layout(constant_id = 4) const int elempack = 1;
layout(constant_id = 5) const int out_elempack = 1;

#define shape_constant_id_offset 6
layout(constant_id = shape_constant_id_offset + 0) const int c = 0;
layout(constant_id = shape_constant_id_offset + 1) const int cstep = 0;
layout(constant_id = shape_constant_id_offset + 2) const int outc = 0;
layout(constant_id = shape_constant_id_offset + 3) const int outcstep = 0;
layout(constant_id = shape_constant_id_offset + 4) const int outcstep_native = 0;
layout(constant_id = shape_constant_id_offset + 5) const int size = 0;
layout(constant_id = shape_constant_id_offset + 6) const int num_output = 0;
layout(constant_id = shape_constant_id_offset + 7) const int num_input = 0;

layout(binding = 0) readonly buffer bottom_blob { sfpvec4 bottom_blob_data[]; };
layout(binding = 1) writeonly buffer top_blob { sfpvec4 top_blob_data[]; };
layout(binding = 2) readonly buffer weight_blob { sfpvec4 weight_data[]; };
layout(binding = 3) readonly buffer bias_blob { sfpvec4 bias_data[]; };

layout(push_constant) uniform parameter
{
    int c;
    int cstep;
    int outc;
    int outcstep;
    int outcstep_native;
    int size;
    int num_output;
    int num_input;
} p;

#if NCNN_shader_local_memory
shared lfpvec4 tmp_v[8][LOCAL_MEMORY_UNROLL_INCH][4];
shared lfpvec4 tmp_k[8][LOCAL_MEMORY_UNROLL_INCH][4];
#endif

#if !NCNN_fp16_storage && !NCNN_fp16_packed && !NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
// Adreno 660 lowers GLSL fma to separately rounded multiply/add. Recover the
// product and addition residuals for this bounded FP32 projection diagnostic.
// precise applies to every intermediate: contraction destroys the residuals.
vec4 fold3_projection_fma(vec4 a, vec4 b, vec4 c)
{
    precise vec4 ah = uintBitsToFloat(floatBitsToUint(a) & uvec4(0xfffff000u));
    precise vec4 bh = uintBitsToFloat(floatBitsToUint(b) & uvec4(0xfffff000u));
    precise vec4 al = a - ah;
    precise vec4 bl = b - bh;
    precise vec4 product = a * b;
    precise vec4 error = ((ah * bh - product) + ah * bl + al * bh) + al * bl;
    precise vec4 total = product + c;
    precise vec4 part = total - product;
    precise vec4 residual = (product - (total - part)) + (c - part);
    return total + (residual + error);
}
#endif

void main()
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);

#if !NCNN_shader_local_memory
    if (gx >= psc(size) || gy >= psc(outc))
        return;
#endif

    // Pinned driver projection prefix: sequential FP32 FMA and bias last. Vulkan packs
    // channels independently of the public tensor layout; handle both packs.
    // The uniform branch returns before every local-memory barrier.
#if !NCNN_fp16_storage && !NCNN_fp16_packed && !NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
    if (activation_type == 0 &&
        ((bias_term == 1 && psc(num_input) == 960 && psc(num_output) == 1280) ||
         (bias_term == 0 && psc(num_input) == 512 && psc(num_output) == 128) ||
         (bias_term == 1 && psc(num_input) == 128 && psc(num_output) == 960)))
    {
        if (gx >= psc(size) || gy >= psc(outc)) return;
        precise vec4 results[4];
        for (int spatial = 0; spatial < 4; ++spatial)
        {
            precise vec4 sum = vec4(0.f);
            for (int ci = 0; ci < psc(num_input); ++ci)
            {
                float value;
                if (elempack == 4)
                    value = buffer_ld4(bottom_blob_data, (ci / 4) * psc(cstep) + gx * 4 + spatial)[ci % 4];
                else
                    value = buffer_ld4(bottom_blob_data, ci * psc(cstep) + gx)[spatial];
                int wi = gy * psc(c) * 4 + (ci / 4) * 4;
                vec4 weights = vec4(buffer_ld4(weight_data, wi)[ci % 4],
                                    buffer_ld4(weight_data, wi + 1)[ci % 4],
                                    buffer_ld4(weight_data, wi + 2)[ci % 4],
                                    buffer_ld4(weight_data, wi + 3)[ci % 4]);
                sum = fold3_projection_fma(vec4(value), weights, sum);
            }
            results[spatial] = bias_term == 1 ? sum + buffer_ld4(bias_data, gy) : sum;
        }
        if (out_elempack == 4)
        {
            for (int spatial = 0; spatial < 4; ++spatial)
                if (gx * 4 + spatial < psc(outcstep))
                    buffer_st4(top_blob_data, gy * psc(outcstep) + gx * 4 + spatial, results[spatial]);
        }
        else
        {
            for (int lane = 0; lane < 4; ++lane)
                if (gy * 4 + lane < psc(num_output))
                    buffer_st4(top_blob_data, (gy * 4 + lane) * psc(outcstep) + gx,
                               vec4(results[0][lane], results[1][lane], results[2][lane], results[3][lane]));
        }
        return;
    }
#endif

    // sum0..sum3: each afpvec4 = 4 output channels, one spatial position
    // gx indexes one sfpvec4 = 4 spatial positions
    afpvec4 sum0;
    afpvec4 sum1;
    afpvec4 sum2;
    afpvec4 sum3;

    if (bias_term == 1)
    {
        afpvec4 b = buffer_ld4(bias_data, gy);
        sum0 = b;
        sum1 = b;
        sum2 = b;
        sum3 = b;
    }
    else
    {
        sum0 = afpvec4(0.f);
        sum1 = afpvec4(0.f);
        sum2 = afpvec4(0.f);
        sum3 = afpvec4(0.f);
    }

    // weight layout: (num_input_packed/4, outc_pack4), each element is mat4 (4x4)
    // always 4 vec4 per weight element
    int w_offset = gy * psc(c) * 4;

#if NCNN_shader_local_memory
    const int lx = int(gl_LocalInvocationID.x);
    const int ly = int(gl_LocalInvocationID.y);

    int z = 0;
    for (; z + (LOCAL_MEMORY_UNROLL_INCH - 1) < psc(c); z += LOCAL_MEMORY_UNROLL_INCH)
    {
        // load input tile
        if (ly < 4)
        {
            if (elempack == 4)
            {
                for (int z4 = 0; z4 < LOCAL_MEMORY_UNROLL_INCH; z4++)
                {
                    tmp_v[lx][z4][ly] = buffer_sm4(bottom_blob_data, gx * 4 + ly + (z + z4) * psc(cstep));
                }
            }
            else // elempack == 1
            {
                for (int z4 = 0; z4 < LOCAL_MEMORY_UNROLL_INCH; z4++)
                {
                    if ((z + z4) * 4 + ly < psc(num_input))
                        tmp_v[lx][z4][ly] = buffer_sm4(bottom_blob_data, gx + ((z + z4) * 4 + ly) * psc(cstep));
                    else
                        tmp_v[lx][z4][ly] = lfpvec4(0);
                }
            }
        }

        // load weight tile
        if (lx < 4)
        {
            for (int z4 = 0; z4 < LOCAL_MEMORY_UNROLL_INCH; z4++)
            {
                tmp_k[ly][z4][lx] = buffer_sm4(weight_data, w_offset + z4 * 4 + lx);
            }
        }

        barrier();

        for (int z4 = 0; z4 < LOCAL_MEMORY_UNROLL_INCH; z4++)
        {
            afpvec4 v0, v1, v2, v3;

            if (elempack == 4)
            {
                v0 = lfp2afpvec4(tmp_v[lx][z4][0]);
                v1 = lfp2afpvec4(tmp_v[lx][z4][1]);
                v2 = lfp2afpvec4(tmp_v[lx][z4][2]);
                v3 = lfp2afpvec4(tmp_v[lx][z4][3]);
            }
            else // elempack == 1
            {
                // transpose from channel-major to spatial-major
                afpvec4 r0 = lfp2afpvec4(tmp_v[lx][z4][0]);
                afpvec4 r1 = lfp2afpvec4(tmp_v[lx][z4][1]);
                afpvec4 r2 = lfp2afpvec4(tmp_v[lx][z4][2]);
                afpvec4 r3 = lfp2afpvec4(tmp_v[lx][z4][3]);

                v0 = afpvec4(r0.r, r1.r, r2.r, r3.r);
                v1 = afpvec4(r0.g, r1.g, r2.g, r3.g);
                v2 = afpvec4(r0.b, r1.b, r2.b, r3.b);
                v3 = afpvec4(r0.a, r1.a, r2.a, r3.a);
            }

            afpvec4 k0 = lfp2afpvec4(tmp_k[ly][z4][0]);
            afpvec4 k1 = lfp2afpvec4(tmp_k[ly][z4][1]);
            afpvec4 k2 = lfp2afpvec4(tmp_k[ly][z4][2]);
            afpvec4 k3 = lfp2afpvec4(tmp_k[ly][z4][3]);

            afpmat4 k = afpmat4(k0, k1, k2, k3);

            sum0 += v0 * k;
            sum1 += v1 * k;
            sum2 += v2 * k;
            sum3 += v3 * k;
        }

        w_offset += LOCAL_MEMORY_UNROLL_INCH * 4;

        barrier();
    }

    // remainder
    if (z < psc(c))
    {
        const int remain = psc(c) - z;

        if (ly < 4)
        {
            if (elempack == 4)
            {
                for (int z4 = 0; z4 < remain; z4++)
                {
                    tmp_v[lx][z4][ly] = buffer_sm4(bottom_blob_data, gx * 4 + ly + (z + z4) * psc(cstep));
                }
            }
            else // elempack == 1
            {
                for (int z4 = 0; z4 < remain; z4++)
                {
                    if ((z + z4) * 4 + ly < psc(num_input))
                        tmp_v[lx][z4][ly] = buffer_sm4(bottom_blob_data, gx + ((z + z4) * 4 + ly) * psc(cstep));
                    else
                        tmp_v[lx][z4][ly] = lfpvec4(0);
                }
            }
        }

        if (lx < 4)
        {
            for (int z4 = 0; z4 < remain; z4++)
            {
                tmp_k[ly][z4][lx] = buffer_sm4(weight_data, w_offset + z4 * 4 + lx);
            }
        }

        barrier();

        for (int z4 = 0; z4 < remain; z4++)
        {
            afpvec4 v0, v1, v2, v3;

            if (elempack == 4)
            {
                v0 = lfp2afpvec4(tmp_v[lx][z4][0]);
                v1 = lfp2afpvec4(tmp_v[lx][z4][1]);
                v2 = lfp2afpvec4(tmp_v[lx][z4][2]);
                v3 = lfp2afpvec4(tmp_v[lx][z4][3]);
            }
            else // elempack == 1
            {
                afpvec4 r0 = lfp2afpvec4(tmp_v[lx][z4][0]);
                afpvec4 r1 = lfp2afpvec4(tmp_v[lx][z4][1]);
                afpvec4 r2 = lfp2afpvec4(tmp_v[lx][z4][2]);
                afpvec4 r3 = lfp2afpvec4(tmp_v[lx][z4][3]);

                v0 = afpvec4(r0.r, r1.r, r2.r, r3.r);
                v1 = afpvec4(r0.g, r1.g, r2.g, r3.g);
                v2 = afpvec4(r0.b, r1.b, r2.b, r3.b);
                v3 = afpvec4(r0.a, r1.a, r2.a, r3.a);
            }

            afpvec4 k0 = lfp2afpvec4(tmp_k[ly][z4][0]);
            afpvec4 k1 = lfp2afpvec4(tmp_k[ly][z4][1]);
            afpvec4 k2 = lfp2afpvec4(tmp_k[ly][z4][2]);
            afpvec4 k3 = lfp2afpvec4(tmp_k[ly][z4][3]);

            afpmat4 k = afpmat4(k0, k1, k2, k3);

            sum0 += v0 * k;
            sum1 += v1 * k;
            sum2 += v2 * k;
            sum3 += v3 * k;
        }
    }
#else
    for (int z = 0; z < psc(c); z++)
    {
        afpvec4 v0, v1, v2, v3;

        if (elempack == 4)
        {
            // each sfpvec4 = 4 input channels at one spatial position
            // 4 spatial positions = 4 consecutive vec4
            int v_offset = gx * 4 + z * psc(cstep);
            v0 = buffer_ld4(bottom_blob_data, v_offset + 0);
            v1 = buffer_ld4(bottom_blob_data, v_offset + 1);
            v2 = buffer_ld4(bottom_blob_data, v_offset + 2);
            v3 = buffer_ld4(bottom_blob_data, v_offset + 3);
        }
        else // elempack == 1
        {
            // each sfpvec4 = 4 spatial positions at one input channel
            // read 4 input channels, then transpose to 4 spatial x 4 input
            int v_offset = gx + z * 4 * psc(cstep);
            int ci = z * 4;
            afpvec4 r0 = buffer_ld4(bottom_blob_data, v_offset);
            afpvec4 r1 = ci + 1 < psc(num_input) ? buffer_ld4(bottom_blob_data, v_offset + psc(cstep)) : afpvec4(0.f);
            afpvec4 r2 = ci + 2 < psc(num_input) ? buffer_ld4(bottom_blob_data, v_offset + psc(cstep) * 2) : afpvec4(0.f);
            afpvec4 r3 = ci + 3 < psc(num_input) ? buffer_ld4(bottom_blob_data, v_offset + psc(cstep) * 3) : afpvec4(0.f);

            // transpose: r[channel].spatial -> v[spatial].channel
            v0 = afpvec4(r0.r, r1.r, r2.r, r3.r);
            v1 = afpvec4(r0.g, r1.g, r2.g, r3.g);
            v2 = afpvec4(r0.b, r1.b, r2.b, r3.b);
            v3 = afpvec4(r0.a, r1.a, r2.a, r3.a);
        }

        // weight is always mat4 (4 output channels x 4 input channels)
        afpmat4 k = afpmat4(
            buffer_ld4(weight_data, w_offset + 0),
            buffer_ld4(weight_data, w_offset + 1),
            buffer_ld4(weight_data, w_offset + 2),
            buffer_ld4(weight_data, w_offset + 3));

        // v * mat4: result[j] = dot(v, column_j) = sum over 4 input channels
        sum0 += v0 * k;
        sum1 += v1 * k;
        sum2 += v2 * k;
        sum3 += v3 * k;

        w_offset += 4;
    }
#endif

    sum0 = activation_afpvec4(sum0, activation_type, activation_param_0, activation_param_1);
    sum1 = activation_afpvec4(sum1, activation_type, activation_param_0, activation_param_1);
    sum2 = activation_afpvec4(sum2, activation_type, activation_param_0, activation_param_1);
    sum3 = activation_afpvec4(sum3, activation_type, activation_param_0, activation_param_1);

#if NCNN_shader_local_memory
    if (gx >= psc(size) || gy >= psc(outc))
        return;
#endif

    if (out_elempack == 4)
    {
        // output sfpvec4 = 4 output channels, outcstep in vec4 units
        const int gi = gy * psc(outcstep) + gx * 4;

        buffer_st4(top_blob_data, gi + 0, sum0);
        if (gx * 4 + 1 < psc(outcstep)) buffer_st4(top_blob_data, gi + 1, sum1);
        if (gx * 4 + 2 < psc(outcstep)) buffer_st4(top_blob_data, gi + 2, sum2);
        if (gx * 4 + 3 < psc(outcstep)) buffer_st4(top_blob_data, gi + 3, sum3);
    }
    else // out_elempack == 1
    {
        // output has scalar channels, but we write via sfpvec4
        // sum[spatial].rgba = 4 output channels
        // transpose to out[channel].spatial -> sfpvec4 = 4 spatial positions
        afpvec4 o0 = afpvec4(sum0.r, sum1.r, sum2.r, sum3.r);
        afpvec4 o1 = afpvec4(sum0.g, sum1.g, sum2.g, sum3.g);
        afpvec4 o2 = afpvec4(sum0.b, sum1.b, sum2.b, sum3.b);
        afpvec4 o3 = afpvec4(sum0.a, sum1.a, sum2.a, sum3.a);

        // channel indices for this pack4 group
        const int base_ch = gy * 4;
        const int nout = psc(num_output);

        // outcstep_native is scalar cstep / 4 (in sfpvec4 units)
        const int gi = base_ch * psc(outcstep_native) + gx;

        buffer_st4(top_blob_data, gi, o0);
        if (base_ch + 1 < nout) buffer_st4(top_blob_data, gi + psc(outcstep_native), o1);
        if (base_ch + 2 < nout) buffer_st4(top_blob_data, gi + psc(outcstep_native) * 2, o2);
        if (base_ch + 3 < nout) buffer_st4(top_blob_data, gi + psc(outcstep_native) * 3, o3);
    }
}
