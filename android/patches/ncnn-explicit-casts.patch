+void main()
+{
+    int col = int(gl_GlobalInvocationID.x);
+    int row = int(gl_GlobalInvocationID.y);
+    int head = int(gl_GlobalInvocationID.z);
+    if (col >= p.n || row >= 9 || head >= 8)
+        return;
+
+    precise float total = 0.0;
+    int a = head * p.left_stride + row * p.k;
+    int b = head * p.right_stride + col;
+    // Match the strict OpenCL reference's half FDOT pairs and odd K tail.
+    for (int i = 0; i + 1 < p.k; i += 2)
+    {
+        precise float pair = left_data[a + i] * right_data[b + i * p.n] +
+                             left_data[a + i + 1] * right_data[b + (i + 1) * p.n];
+        total += pair;
+    }
+    if ((p.k & 1) != 0)
+        total += left_data[a + p.k - 1] * right_data[b + (p.k - 1) * p.n];
+    output_data[head * p.output_stride + row * p.n + col] =
+        unpackHalf2x16(packHalf2x16(vec2(total, 0.0))).x;
+}
