+// Fold3 reference arithmetic, BSD-3-Clause. Diagnostic until full-model parity.
+#version 450
+#include "vulkan_activation.comp"
+
+layout(binding = 0) buffer input_blob { float values[]; };
+layout(binding = 1) readonly buffer gamma_blob { float gamma[]; };
+layout(binding = 2) readonly buffer beta_blob { float beta[]; };
+layout(push_constant) uniform parameter { int width; int rows; int cstep; float epsilon; } p;
+shared float average;
+shared float deviation;
+
+float half_rte(float value)
+{
+    uint bits = floatBitsToUint(value), sign = (bits >> 16) & 0x8000u;
+    uint magnitude = bits & 0x7fffffffu, result;
+    if (magnitude > 0x7f800000u) result = 0x7e00u;
+    else if (magnitude >= 0x477ff000u) result = 0x7c00u;
+    else if (magnitude >= 0x38800000u)
+        result = (magnitude + 0xfffu + ((magnitude >> 13) & 1u) - 0x38000000u) >> 13;
+    else if (magnitude <= 0x33000000u) result = 0u;
+    else
+    {
+        uint shift = 126u - (magnitude >> 23);
+        uint mantissa = (magnitude & 0x7fffffu) | 0x800000u;
+        result = (mantissa + ((1u << (shift - 1u)) - 1u) + ((mantissa >> shift) & 1u)) >> shift;
+    }
+    return unpackHalf2x16(sign | result).x;
+}
+
+// Exact 52-bit midpoint comparisons without requiring shaderInt64 support.
+uvec2 square64(uint value)
+{
+    uint high, low;
+    umulExtended(value, value, high, low);
+    return uvec2(low, high);
+}
+uvec2 shifted64(uint value, uint shift) { return uvec2(value << shift, value >> (32u - shift)); }
+bool less64(uvec2 a, uvec2 b) { return a.y < b.y || (a.y == b.y && a.x < b.x); }
+float rounded_sqrt(float value)
+{
+    uint bits = floatBitsToUint(value), exponent = (bits >> 23) & 255u;
+    if (!(value > 0.f) || exponent == 0u || exponent == 255u) return sqrt(value);
+    uint expected = (exponent + 127u) >> 1;
+    uint mantissa = (bits & 0x7fffffu) | 0x800000u;
+    uint shift = 23u + ((exponent - 127u) & 1u);
+    float result = sqrt(value);
+    for (int i = 0; i < 4; i++)
+    {
+        uint encoded = floatBitsToUint(result);
+        uint current = ((encoded & 0x7fffffu) | 0x800000u) << ((encoded >> 23) + 1u - expected);
+        bool up = less64(square64(current), shifted64(mantissa, shift + 2u));
+        uint neighbor = up ? encoded + 1u : encoded - 1u;
+        uint adjacent = ((neighbor & 0x7fffffu) | 0x800000u) << ((neighbor >> 23) + 1u - expected);
+        uvec2 midpoint = square64(current + adjacent), radicand = shifted64(mantissa, shift + 4u);
+        bool move = up ? less64(midpoint, radicand) : less64(radicand, midpoint);
+        if (all(equal(midpoint, radicand)) && (encoded & 1u) != 0u) move = true;
+        result = uintBitsToFloat(move ? neighbor : encoded);
+    }
+    return result;
+}
+
+void main()
+{
+    int row = int(gl_WorkGroupID.y), channel = int(gl_WorkGroupID.z);
+    int offset = channel * p.cstep + row * p.width;
+    int lane = int(gl_LocalInvocationID.x);
+    if (row >= p.rows) return;
+    if (lane == 0)
+    {
+        precise float mean = 0.f, m2 = 0.f;
+        for (int i = 0; i < p.width; i++)
+        {
+            float value = half_rte(values[offset + i]);
+            precise float delta = value - mean;
+            precise float next_mean = mean + fold3_activation_divide(delta, float(i + 1));
+            precise float centered = value - next_mean;
+            m2 = fold3_activation_fma(delta, centered, m2);
+            mean = next_mean;
+        }
+        precise float variance = fold3_activation_divide(m2, float(p.width)) + p.epsilon;
+        average = mean;
+        deviation = rounded_sqrt(variance);
+    }
+    barrier();
+    for (int i = lane; i < p.width; i += 64)
+    {
+        precise float centered = half_rte(values[offset + i]) - average;
+        float normalized = fold3_activation_divide(centered, deviation);
+        values[offset + i] = half_rte(fold3_activation_fma(normalized, gamma[i], beta[i]));
