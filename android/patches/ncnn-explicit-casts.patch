+#version 450
+
+layout(binding = 0) readonly buffer Left { float left_data[]; };
+layout(binding = 1) readonly buffer Right { float right_data[]; };
+layout(binding = 2) writeonly buffer Output { float output_data[]; };
+
+layout(push_constant) uniform Params
+{
+    int k;
+    int n;
+    int left_stride;
+    int right_stride;
+    int output_stride;
+} p;
