+// SPDX-License-Identifier: BSD-3-Clause
+#include "matmul_vulkan.h"
+#include "layer_shader_type.h"
+
+namespace ncnn {
+
+MatMul_vulkan::MatMul_vulkan() : pipeline(0)
+{
+    support_vulkan = true;
+}
+
+int MatMul_vulkan::create_pipeline(const Option& opt)
+{
+    pipeline = new Pipeline(vkdev);
+    pipeline->set_optimal_local_size_xyz(8, 4, 1);
+    return pipeline->create(LayerShaderType::matmul, opt, {});
+}
+
+int MatMul_vulkan::destroy_pipeline(const Option&)
+{
+    delete pipeline;
+    pipeline = 0;
+    return 0;
+}
+
+int MatMul_vulkan::forward(const std::vector<VkMat>& inputs, std::vector<VkMat>& outputs,
+                          VkCompute& cmd, const Option& opt) const
+{
+    if (inputs.size() != 2 || outputs.size() != 1 || transB)
+        return -1;
+    const VkMat& a = inputs[0];
+    const VkMat& b = inputs[1];
+    const int k = a.w;
+    const int n = b.w;
+    // The two pinned attention products have eight independent heads.
+    const bool depth_heads = a.dims == 4 && b.dims == 4 && a.c == 1 && b.c == 1 && a.d == 8 && b.d == 8;
+    const bool channel_heads = a.dims == 3 && b.dims == 3 && a.c == 8 && b.c == 8;
+    if ((!depth_heads && !channel_heads) || a.h != 9 || b.h != k
+        || !((k == 64 && n == 9) || (k == 9 && n == 64))
+        || a.elempack != 1 || b.elempack != 1 || a.elemsize != 4u || b.elemsize != 4u)
+        return -1;
+
+    VkMat& output = outputs[0];
+    if (depth_heads)
+        output.create(n, 9, 8, 1, 4u, 1, opt.blob_vkallocator);
+    else
+        output.create(n, 9, 8, 4u, 1, opt.blob_vkallocator);
+    if (output.empty())
+        return -100;
+
+    std::vector<vk_constant_type> constants(5);
+    constants[0].i = k;
+    constants[1].i = n;
+    constants[2].i = depth_heads ? 9 * k : a.cstep;
+    constants[3].i = depth_heads ? k * n : b.cstep;
+    constants[4].i = depth_heads ? 9 * n : output.cstep;
+    VkMat dispatcher;
+    dispatcher.w = n;
+    dispatcher.h = 9;
+    dispatcher.c = 8;
+    cmd.record_pipeline(pipeline, {a, b, output}, constants, dispatcher);
+    return 0;
+}
+
