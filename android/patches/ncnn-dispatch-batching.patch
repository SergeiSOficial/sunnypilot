--- a/src/fold3_dispatch.h
+++ b/src/fold3_dispatch.h
@@ -0,0 +1,18 @@
+// Fold 3 diagnostic batch limit; retain bounded timeout-prevention submissions.
+#ifndef NCNN_FOLD3_DISPATCH_H
+#define NCNN_FOLD3_DISPATCH_H
+#include <stdint.h>
+#include <string.h>
+namespace ncnn {
+static inline uint32_t fold3_dispatch_limit(uint32_t vendor, const char* name, uint32_t stock, uint32_t diagnostic = 0)
+{
+    // Session-local diagnostic override on the exact Fold GPU only.
+    if (vendor != 0x5143 || !name || strcmp(name, "Adreno (TM) 660") != 0)
+        return stock;
+    if (diagnostic == 131072u || diagnostic == 262144u || diagnostic == 524288u)
+        return diagnostic;
+    // Preserve the existing default and its stock upper bounds.
+    return stock < 262144u ? 262144u : stock;
+}
+}
+#endif
