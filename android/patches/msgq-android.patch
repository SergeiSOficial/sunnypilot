--- /dev/null
+++ b/msgq/android_ipc.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cerrno>
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// All Android service processes must set the same app-private directory.
+inline std::string msgq_android_path(const std::string &name) {
+  const char *root = std::getenv("MSGQ_ANDROID_PATH");
+  struct stat st{};
+  if (!root || root[0] != '/' || stat(root, &st) || !S_ISDIR(st.st_mode) ||
+      st.st_uid != getuid() || (st.st_mode & 0077)) {
+    throw std::runtime_error("MSGQ_ANDROID_PATH must be an existing private application directory");
+  }
+  if (name.empty() || name.find('/') != std::string::npos || name == "." || name == "..") {
+    throw std::invalid_argument("Invalid Android IPC endpoint");
+  }
+  std::string directory(root);
+  if (const char *prefix = std::getenv("OPENPILOT_PREFIX"); prefix && *prefix) {
+    std::string value(prefix);
+    if (value.size() > 24 || value.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-") != std::string::npos) {
+      throw std::invalid_argument("Invalid Android IPC prefix");
+    }
+    directory += "/" + value;
+    if (mkdir(directory.c_str(), 0700) && errno != EEXIST) throw std::runtime_error("Cannot create Android IPC namespace");
+    if (lstat(directory.c_str(), &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() || (st.st_mode & 0077))
+      throw std::runtime_error("Android IPC namespace must be a private application directory");
+  }
+  return directory + "/" + name;
+}
