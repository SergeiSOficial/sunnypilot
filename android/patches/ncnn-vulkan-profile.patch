 namespace ncnn {
+
+// Thread-local, bounded profiling. Queries are read only at existing submission fences.
+struct Fold3VulkanTiming
+{
+    std::string name, type;
+    uint64_t start, end;
+    double milliseconds;
+};
+struct Fold3VulkanProfile
+{
+    bool enabled = false;
+    bool valid = true;
+    uint32_t timestamp_bits = 0;
+    std::vector<Fold3VulkanTiming> records;
+};
+NCNN_EXPORT Fold3VulkanProfile& fold3_vulkan_profile();
+NCNN_EXPORT void fold3_record_vulkan_profile(const Layer* layer, uint64_t start, uint64_t end, float period);
 
 // get now timestamp in ms
 NCNN_EXPORT double get_current_time();
--- a/src/benchmark.cpp
+++ b/src/benchmark.cpp
@@ -41,6 +41,26 @@
 
 namespace ncnn {
 
+Fold3VulkanProfile& fold3_vulkan_profile()
+{
+    static thread_local Fold3VulkanProfile profile;
+    return profile;
+}
+void fold3_record_vulkan_profile(const Layer* layer, uint64_t start, uint64_t end, float period)
+{
+    Fold3VulkanProfile& p = fold3_vulkan_profile();
+    if (!p.enabled || !start || !end) return;
+    if (!p.timestamp_bits || p.timestamp_bits > 64 || p.records.size() >= 16384 || !(period > 0.f))
+    {
+        p.valid = false;
+        return;
+    }
+    const uint64_t mask = p.timestamp_bits == 64 ? ~uint64_t(0) : (uint64_t(1) << p.timestamp_bits) - 1;
+    const uint64_t ticks = (end - start) & mask;
+    p.records.push_back({layer->name, layer->type, start, end, ticks * double(period) / 1000000.0});
+}
+
+
 double get_current_time()
 {
