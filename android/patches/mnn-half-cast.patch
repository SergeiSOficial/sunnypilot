+    if (cb * 4 + 1 >= outputChannels) result.y = 0.0f;
+    if (cb * 4 + 2 >= outputChannels) result.z = 0.0f;
+    if (cb * 4 + 3 >= outputChannels) result.w = 0.0f;
+    output[((cb * batch + n) * outHW.x + oy) * outHW.y + ox] = result;
+}
