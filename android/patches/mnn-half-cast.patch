+inline float fold3_layernorm_sqrt(float value) {
+    uint bits = as_uint(value), exponent = (bits >> 23) & 255U;
+    float result = sqrt(value);
+    if (!(value > 0.0f) || exponent == 0U || exponent == 255U) return result;
+    uint expectedExponent = (exponent + 127U) >> 1;
+    ulong radicand = (ulong)((bits & 0x7fffffU) | 0x800000U) << (23U + ((exponent - 127U) & 1U));
+    // Correct the native root's bounded ulp error with exact integer midpoint
+    // comparisons, as in the already verified strict OpenCL reference.
+    for (int i = 0; i < 4; ++i) {
+        uint encoded = as_uint(result);
+        ulong significand = (ulong)((encoded & 0x7fffffU) | 0x800000U) << ((encoded >> 23) + 1U - expectedExponent);
+        bool up = 4UL * radicand > significand * significand;
+        uint neighbor = up ? encoded + 1U : encoded - 1U;
+        ulong adjacent = (ulong)((neighbor & 0x7fffffU) | 0x800000U) << ((neighbor >> 23) + 1U - expectedExponent);
+        ulong midpoint = (significand + adjacent) * (significand + adjacent);
