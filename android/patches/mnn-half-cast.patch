+// Original FP32 host Conv uses ky/kx/input-channel ordered FMAs. The
+// NHWC fusion preloads bias; ordinary Conv adds it after the reduction.
+// Tags originate from pinned host Conv and verified static FP32 GEMV paths.
+ErrorCode ConvBufCommonExecution::encodeFold3HostConv(Tensor* input, Tensor* output, Unit& unit) {
+    const auto in = tensorShapeFormat(input), out = tensorShapeFormat(output);
+    const auto common = mResource->mConv2dCommonParams;
+    const int groups = common->group();
+    const bool depthwise = groups == in[3] && out[3] == in[3];
+    if (mOpenCLBackend->getPrecision() != BackendConfig::Precision_High ||
+        (groups != 1 && !depthwise) || in[0] != out[0] || common->relu6() || mResource->mPrelu) {
+        return NOT_SUPPORT;
+    }
+    std::set<std::string> options;
+    if (mResource->mFold3HostBiasFirst) options.emplace("-DFOLD3_BIAS_FIRST");
+    if (depthwise) options.emplace("-DFOLD3_DEPTHWISE");
+    // Vectorize loads while retaining correctly rounded, ordered FMA.
+    // The MAD variant failed full-model accuracy and is not selected.
+    // Do not change the separately qualified half FDOT2/depthwise reductions.
+    if (!depthwise && !mResource->mFold3HalfDot2) options.emplace("-DFOLD3_VECTOR_FMA_CONV");
+    if (common->relu()) options.emplace("-DFOLD3_RELU");
+    unit.kernel = mOpenCLBackend->getOpenCLRuntime()->buildKernel(
+        "fold3_host_conv_buf", mResource->mFold3HalfDot2 ? "fold3_half_dot2" : "fold3_host_conv",
+        options, BackendConfig::Precision_High);
+    if (!unit.kernel) return NOT_SUPPORT;
+    auto padding = ConvolutionCommon::convolutionPad(input, output, common);
+    const int inputShape[2] = {in[1], in[2]}, outputShape[2] = {out[1], out[2]};
+    const int kernelShape[2] = {common->kernelY(), common->kernelX()};
+    const int stride[2] = {common->strideY(), common->strideX()};
+    const int dilation[2] = {common->dilateY(), common->dilateX()};
+    const int pads[2] = {padding.second, padding.first};
+    auto& kernel = unit.kernel->get();
+    int index = 0;
+    cl_int error = kernel.setArg(index++, openCLBuffer(input));
+    error |= kernel.setArg(index++, openCLBuffer(mResource->mFilter.get()));
+    error |= kernel.setArg(index++, openCLBuffer(mResource->mBias.get()));
+    error |= kernel.setArg(index++, openCLBuffer(output));
+    error |= kernel.setArg(index++, in[0]);
+    error |= kernel.setArg(index++, in[3]);
+    error |= kernel.setArg(index++, out[3]);
+    error |= kernel.setArg(index++, sizeof(inputShape), inputShape);
+    error |= kernel.setArg(index++, sizeof(outputShape), outputShape);
+    error |= kernel.setArg(index++, sizeof(kernelShape), kernelShape);
+    error |= kernel.setArg(index++, sizeof(stride), stride);
+    error |= kernel.setArg(index++, sizeof(dilation), dilation);
+    error |= kernel.setArg(index++, sizeof(pads), pads);
+    if (error != CL_SUCCESS) return NOT_SUPPORT;
+    unit.globalWorkSize = cl::NDRange(ROUND_UP(UP_DIV(out[3], 4) * out[2], 32), out[0] * out[1]);
+    unit.localWorkSize = cl::NDRange(32, 1);
+    return NO_ERROR;
+}
