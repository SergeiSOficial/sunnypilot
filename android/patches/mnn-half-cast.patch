+// Diagnostic precision repair for the original ARM64 half GEMV reduction.
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+#pragma OPENCL FP_CONTRACT OFF
+inline float fold3_half_rte(float value) {
+    half rounded;
+    vstore_half_rte(value, 0, &rounded);
+    return vload_half(0, &rounded);
+}
+inline float fold3_half_fma(float x, float y, float z) {
+    // Half products are exact in FP32. Keep the addition residual to avoid
+    // double rounding at a binary16 midpoint. Volatile prevents contraction
+    // or algebraic cancellation under MNN's global mad build option.
+    volatile float product = x * y;
+    volatile float total = product + z;
+    volatile float part = total - product;
+    volatile float remainder = total - part;
+    volatile float left = product - remainder;
+    volatile float right = z - part;
+    volatile float error = left + right;
+    uint bits = as_uint((float)total);
+    uint exponent = (bits >> 23) & 255u;
+    uint shift = (uint)clamp(126 - (int)exponent, 13, 24);
+    float adjusted = total;
+    if (exponent >= 102u && exponent <= 142u && error != 0.0f &&
+        ((((bits & 0x7fffffu) | 0x800000u) & ((1u << shift) - 1u)) == (1u << (shift - 1u)))) {
+        adjusted = nextafter(adjusted, copysign(INFINITY, (float)error));
+    }
+    return fold3_half_rte(adjusted);
+}
+__kernel void fold3_half_gemv8(__global const float* input, __global const float* weights,
+                              __global const float* bias, __global float* output,
+                              const int k, const int n) {
+    int row = get_global_id(0);
+    if (row >= n) {
+        if (row < ((n + 3) / 4) * 4) output[row] = 0.0f;
+        return;
+    }
+    const int end = (k / 8) * 8;
+    const int coefficient = end > 0 && k + n + 1 < 20;
+    const int packets = n == 1 && !coefficient ? min(4, max(1, end / 8)) : 1;
+    float partial[32] = {0.0f};
+    if (coefficient) {
+        for (int lane = 0; lane < 8; ++lane) {
+            partial[lane] = fold3_half_rte(input[lane] * weights[row * k + lane]);
+            if (end > 8) {
+                float other = fold3_half_rte(input[8 + lane] * weights[row * k + 8 + lane]);
+                partial[lane] = fold3_half_rte(partial[lane] + other);
+            }
+        }
+    } else {
+        for (int start = 0; start < end; start += 8) {
+            int packet = (start / 8) % packets;
+            for (int lane = 0; lane < 8; ++lane) {
+                int index = packet * 8 + lane;
+                partial[index] = fold3_half_fma(input[start + lane], weights[row * k + start + lane], partial[index]);
+            }
+        }
+    }
+    // Eigen combines scalar-dot packets from right to left.
+    float lanes[8];
+    for (int lane = 0; lane < 8; ++lane) {
+        lanes[lane] = partial[(packets - 1) * 8 + lane];
+        for (int packet = packets - 2; packet >= 0; --packet) {
+            lanes[lane] = fold3_half_rte(partial[packet * 8 + lane] + lanes[lane]);
+        }
+    }
+    for (int width = 4; width >= 1; width /= 2) {
+        for (int lane = 0; lane < width; ++lane) {
+            lanes[lane] = fold3_half_rte(lanes[lane * 2] + lanes[lane * 2 + 1]);
+        }
+    }
+    float value = lanes[0];
+    for (int index = end; index < k; ++index) {
+        float product = fold3_half_rte(input[index] * weights[row * k + index]);
+        value = fold3_half_rte(value + product);
+    }
+    output[row] = fold3_half_rte(value + bias[row]);
+}
