+// Pinned host FP32 Conv: ordered ky/kx/ci accumulation with explicit bias order.
+// NC4HW4 buffers use channel-block/batch/height/width/lane ordering.
+// Four output channels share an input scalar; no CPU partition or readback.
+// Retain correctly rounded FMA and the original sequential reduction.
+// Vector loads remove redundant input addressing without changing arithmetic.
+#pragma OPENCL FP_CONTRACT OFF
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+// A finite binary16 product has at most 22 significant bits and is exact in
+// binary32, including the smallest binary16 subnormal squared. A separately
+// rounded product therefore preserves FMA semantics in this guarded case.
+// Keep the original correctly rounded FMA for all other operands. Volatile
+// prevents -cl-mad-enable from replacing the required accumulator rounding.
+inline float4 fold3_guarded_host_fma(float4 a, float4 b, float4 c) {
+    // Do not rely on the device's unadvertised FP32 denormal support.
+    int4 exact = isfinite(a) & isfinite(b) & isfinite(c)
+        & ((fabs(c) >= (float4)0x1.0p-126f) | (c == (float4)0.0f))
+        & (a == convert_float4(convert_half4_rte(a)))
+        & (b == convert_float4(convert_half4_rte(b)));
+    if (all(exact)) {
+        volatile float4 product = a * b;
+        return product + c;
+    }
+    return fma(a, b, c);
+}
