+  def render_cast(self, u:UOp, val:str) -> str:
+    # Preserve the pinned arm64 RTE boundaries explicitly, including
+    # vectorized conversions and float32 accumulation into half outputs.
+    if u.dtype == dtypes.half and u.addrspace in (AddrSpace.ALU, None):
+      half_type = self.render_type(u)
+      normal = f"convert_{half_type}_rte({val})"
+      if u.src[0].dtype != dtypes.float32: return normal
+      # Evaluate the source once: embedding it several times makes nested
+      # half reductions grow exponentially before OpenCL compilation.
+      return f"fold3_half_rte{u.max_numel()}({val})"
+    return super().render_cast(u, val)
