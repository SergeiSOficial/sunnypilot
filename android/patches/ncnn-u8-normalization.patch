+#if !NCNN_fp16_storage && !NCNN_fp16_packed && !NCNN_fp16_arithmetic && !NCNN_bf16_storage && !NCNN_bf16_packed
+// Exact FP32 division for integer camera samples; retain strict division elsewhere.
+float fold3_u8_divide_255(float value)
+{
+    if (value >= 0.0 && value <= 255.0)
+    {
+        uint pixel = uint(value);
+        if (float(pixel) == value)
+        {
+            if (pixel == 0u) return value; // Preserve negative zero.
+            uint exponent = uint(findMSB(pixel));
+            uint numerator = pixel << (31u - exponent);
+            uint significand = (numerator + 127u) / 255u;
+            // Odd denominator has no rounding ties; addition handles carry at 255.
+            return uintBitsToFloat(((exponent + 118u) << 23u) + significand);
+        }
+    }
+    return fold3_activation_divide(value, 255.0);
+}
+#endif
